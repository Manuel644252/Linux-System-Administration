; Zona inversa - 192.168.8.0/24
$TTL 86400
@   IN  SOA     server.manuel.local. root.manuel.local. (
                2024011501  ; serial
                3600        ; refresh
                1800        ; retry
                604800      ; expire
                86400 )     ; minimum
;
@       IN  NS      server.manuel.local.
1       IN  PTR     server.manuel.local.
3       IN  PTR     client.manuel.local.
